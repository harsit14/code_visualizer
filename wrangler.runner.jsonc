{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "code-visualizer-runner",
  "main": "src/runner/worker.ts",
  "compatibility_date": "2026-06-15",
  "assets": {
    "directory": "./dist-runner",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
}
